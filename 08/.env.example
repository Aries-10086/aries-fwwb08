# 本地 PostgreSQL（与 docker-compose.yml 默认值一致）
POSTGRES_DB=party_school
POSTGRES_USER=party_school
POSTGRES_PASSWORD=party_school
POSTGRES_PORT=5432
DATABASE_URL=postgresql://party_school:party_school@localhost:5432/party_school
DATABASE_SSL=0
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# 应用
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AUTH_SECRET=replace-with-a-long-random-secret
ALLOW_OPEN_REGISTER=1

# 推荐：Node 统一通过 Python AI 服务调用模型、知识库与流式聊天
# 模型地址 / 名称 / API Key 也可在管理端「AI 设置」配置（优先于下方环境变量）
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=replace-with-a-long-random-secret
AI_SERVICE_TIMEOUT_MS=30000
LLM_TIMEOUT_MS=30000
LLM_MODEL=qwen-plus
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_TOP_K=5

# 仅在不使用 Python /text 时启用的 OpenAI-compatible 直连后备配置
LLM_BASE_URL=
LLM_API_KEY=
