# 本地 PostgreSQL（与 docker-compose.yml 默认值一致）
POSTGRES_DB=party_school
POSTGRES_USER=party_school
POSTGRES_PASSWORD=party_school
POSTGRES_PORT=5432
DATABASE_URL=postgresql://party_school:party_school@localhost:5432/party_school
DATABASE_SSL=0
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# 应用
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AUTH_SECRET=replace-with-a-long-random-secret
ALLOW_OPEN_REGISTER=1

# 可选：兼容 OpenAI API 的大模型服务
LLM_BASE_URL=
LLM_API_KEY=
