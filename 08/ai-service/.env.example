# Node -> Python 内部鉴权（至少 16 字符，生产环境必须随机生成）
INTERNAL_API_KEY=replace-with-a-long-random-secret

# 国产 OpenAI-compatible 模型（示例：阿里云百炼）
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=
CHAT_MODEL=qwen-plus
CHAT_TEMPERATURE=0.2

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=party_school_knowledge

CHUNK_SIZE=800
CHUNK_OVERLAP=100
SEARCH_TOP_K=5
MAX_ALLOWED_CONTENT_IDS=2000
MAX_TOOL_ROUNDS=3
REQUEST_TIMEOUT_SECONDS=30

# 可选内网只读工具。URL 必须为 localhost、私网 IP 或 .local/.internal 域名。
# auth_token 仅从服务端环境读取，不应出现在 Node 请求或模型上下文。
INTERNAL_TOOLS_JSON=[]
